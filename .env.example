# ==========================================
# School Management System - Environment Variables Example
# ==========================================

# ------------------------------------------
# Backend Configurations (.NET Core 8 Web API)
# ------------------------------------------
# PostgreSQL Database Connection String
ConnectionStrings__DefaultConnection="Host=localhost;Port=5432;Database=School_management_system;Username=postgres;Password=your_password_here"

# JWT Token Configurations
Jwt__Secret="YourSuperSecretMinimum16CharacterKeyHere12345!"
Jwt__Issuer="SchoolManagement"
Jwt__Audience="SchoolManagement"

# Logging & Hosts
Logging__LogLevel__Default="Information"
Logging__LogLevel__Microsoft.AspNetCore="Warning"
AllowedHosts="*"

# ------------------------------------------
# Frontend Configurations (Next.js / TypeScript)
# ------------------------------------------
# Base URL for the Backend API endpoints
NEXT_PUBLIC_API_URL="http://localhost:5000/api"
